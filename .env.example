# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiseo?schema=public"

# Redis Queue Configuration (BullMQ)
REDIS_URL="redis://localhost:6379"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LLM Provider Configuration
# Supported providers: "mock", "openai", "anthropic", "gemini", "groq"
LLM_PROVIDER="mock"
LLM_MODEL="mock-seo-gpt4"

# External LLM Provider API Keys (Leave blank to use built-in deterministic Mock Provider)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# GitHub Integration (Mode A: Source-code execution)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""

# Google Search Console & GA4 Integration (Mode B)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Security & Encryption Key for Stored Credentials (32-byte hex string)
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
